# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# These values are not secret (security comes from the rules and the end-to-end
# encryption), but they are kept out of the repository anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Optional: set to 1 only if Firebase let you point the email action URL at
# Trazo's own reset page (docs/SETUP.md, "Optional: Trazo's own reset page").
# Otherwise password resets use Firebase's page with a temporary password.
# VITE_TRAZO_RESET_PAGE=1

# Development only: talk to the local emulators (npm run emulators) instead.
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
